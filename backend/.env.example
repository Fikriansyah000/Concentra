# App
APP_NAME=Concentra API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql+asyncpg://concentra:concentra_dev_2024@localhost:5432/concentra_dev
DATABASE_URL_SYNC=postgresql://concentra:concentra_dev_2024@localhost:5432/concentra_dev

# Auth
USE_LOCAL_AUTH=true
LOCAL_JWT_SECRET=concentra_dev_secret_key_change_in_production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS
CORS_ORIGINS=http://localhost:5173,chrome-extension://*
